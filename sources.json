{
  "$comment": "Catalogue des sources. `registries` = decouverte automatique (AdGuard extension, AdGuard hostlists DNS, FilterLists.com). `extra` = ajouts manuels. `selection` = filtres globaux. Voir README.md.",
  "registries": [
    {
      "id": "adguard",
      "type": "adguard-registry",
      "url": "https://filters.adtidy.org/extension/chromium/filters.json",
      "enabled": true,
      "comment": "Registre extension AdGuard: 88 listes (AdGuard + EasyList/EasyPrivacy/Fanboy/uBO/Peter Lowe/...)"
    },
    {
      "id": "adguard-dns",
      "type": "adguard-hostlists",
      "url": "https://adguardteam.github.io/HostlistsRegistry/assets/filters.json",
      "enabled": true,
      "comment": "Registre Hostlists AdGuard: 64 blocklists DNS (OISD, HaGeZi, 1Hosts, StevenBlack, anti-AD...). Purement domaines: conversion WebKit ~100%."
    },
    {
      "id": "filterlists",
      "type": "filterlists",
      "url": "https://api.filterlists.com/lists",
      "enabled": false,
      "syntaxes": [
        1,
        2,
        3,
        4,
        6,
        14
      ],
      "max_lists": 0,
      "comment": "Annuaire independant FilterLists.com: ~2300 listes, longue traine de qualite inegale. Un appel de detail par liste (~3 min). Mettre enabled=true pour l'activer, max_lists>0 pour plafonner."
    }
  ],
  "selection": {
    "include_deprecated": false,
    "exclude_tags": [
      "obsolete"
    ],
    "exclude_groups": [],
    "exclude_ids": [
      "adguard-dns-49",
      "adguard-dns-51",
      "adguard-dns-48",
      "adguard-dns-27",
      "adguard-dns-70",
      "adguard-dns-44"
    ],
    "include_ids": [],
    "only_recommended": false,
    "_comment_exclude_ids": "Mega-listes DNS (HaGeZi Ultimate/Pro++/Pro, OISD Big, 1Hosts Xtra, Threat Intelligence Feeds): plusieurs centaines de milliers de domaines chacune. Retirer un id d'ici pour l'inclure."
  },
